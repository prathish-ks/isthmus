           go-version-file: go-host/go.mod
 
+      # gofmt check is scoped to this project's own files, excluding
+      # vendor/. Vendored third-party sources are not expected to match
+      # this repo's own gofmt formatting (confirmed here after the first
+      # real CI run found genuine, pre-existing gofmt findings inside
+      # vendor/github.com/google/uuid, vendor/github.com/mattn/go-isatty,
+      # and vendor/github.com/remyoudompheng/bigfft) and this project does
+      # not reformat code it does not own. go vet/build/test below already
+      # only cover this project's own packages (module-mode "./..." never
+      # expands into vendor/ regardless), so this step is the only one that
+      # needed an explicit exclusion.
       - name: gofmt check
         run: |
-          unformatted="$(gofmt -l .)"
+          unformatted="$(gofmt -l . | grep -v '^vendor/' || true)"
           if [ -n "$unformatted" ]; then
             echo "The following files are not gofmt-formatted:"
             echo "$unformatted"
             echo
-            echo "Run: (cd go-host && gofmt -w .)"
+            echo "Run: (cd go-host && gofmt -w .) then re-check nothing under vendor/ was touched"
             exit 1
           fi
 
