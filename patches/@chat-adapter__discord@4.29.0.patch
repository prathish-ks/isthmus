+// Isthmus patch: encode/decode used to join actionId+value with a bare
+// "\n" and split on its first occurrence with no escaping at all. If
+// either part already contained a "\n" — observed in practice as a
+// doubled "0\n0" value reaching NanoClaw's response handlers, most
+// plausibly from a value that was itself already delimiter-joined before
+// reaching this encode step — decode silently returned the wrong,
+// garbled value instead of erroring, and callers (e.g. an approval
+// handler checking `payload.value === 'approve'`) failed closed with no
+// diagnostic at all. Escaping here makes the round trip correct for any
+// content instead of only for values that happen not to contain the
+// delimiter. (The one residual, pre-existing ambiguity this doesn't
+// close: a *value-less* actionId that itself contains a literal "\n"
+// would still be misread as an actionId+value pair on decode — real
+// actionIds in this codebase are always simple colon-joined identifiers,
+// so this is unreachable in practice, not silently assumed away.)
+function escapeDiscordCustomIdPart(s) {
+  return s.replace(/\\/g, "\\\\").replace(/\n/g, "\\n");
+}
